# All optional. Copy to .env or set in your host's dashboard.

# Personal Lichess API token, no scopes needed: https://lichess.org/account/oauth/token
# Needed only for opening_stats (the opening explorer now requires sign-in).
# Leave empty otherwise: a wrong token makes every request fail with 401.
LICHESS_TOKEN=

# Per-request timeout for Lichess calls, ms (stdio default 15000, HTTP default 12000).
LICHESS_TIMEOUT_MS=

# ---- HTTP server only (npm start / dist/http.js) ----
PORT=3000
HOST=0.0.0.0
# Requests per minute per IP on POST /mcp.
RATE_LIMIT_PER_MINUTE=30
# Requests per UTC day on POST /mcp across all callers (keeps one demo from leaning on Lichess).
DAILY_REQUEST_LIMIT=5000
# Largest accepted POST body in bytes.
MAX_BODY_BYTES=65536
# Wall-clock limit for one /mcp request, ms.
REQUEST_TIMEOUT_MS=30000
# "*" or a comma-separated list of allowed browser origins.
CORS_ORIGINS=*
# Number of reverse proxies in front of the app (Render: 1). 0 = use the socket address.
TRUST_PROXY=0
